+void D3D12CommandProcessor::InitializeGpuTimer() {
+  gpu_timer_enabled_ = false;
+  if (FILE* f = std::fopen("gpu_timing", "rb")) {
+    std::fclose(f);
+  } else {
+    return;
+  }
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  ID3D12CommandQueue* queue = GetD3D12Provider().GetDirectQueue();
+  if (!device || !queue || FAILED(queue->GetTimestampFrequency(&gpu_timer_frequency_)) ||
+      !gpu_timer_frequency_) {
+    return;
+  }
+  D3D12_QUERY_HEAP_DESC heap_desc = {};
+  heap_desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+  heap_desc.Count = kGpuTimerQueries;
+  if (FAILED(device->CreateQueryHeap(&heap_desc, IID_PPV_ARGS(&gpu_timer_heap_)))) {
+    return;
+  }
+  D3D12_RESOURCE_DESC buffer_desc;
+  ui::d3d12::util::FillBufferResourceDesc(buffer_desc, sizeof(uint64_t) * kGpuTimerQueries,
+                                          D3D12_RESOURCE_FLAG_NONE);
+  if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesReadback,
+                                             GetD3D12Provider().GetHeapFlagCreateNotZeroed(),
+                                             &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                             IID_PPV_ARGS(&gpu_timer_readback_)))) {
+    gpu_timer_heap_.Reset();
+    return;
+  }
+  D3D12_RANGE read_range = {0, sizeof(uint64_t) * kGpuTimerQueries};
+  void* mapping = nullptr;
+  if (FAILED(gpu_timer_readback_->Map(0, &read_range, &mapping))) {
+    gpu_timer_readback_.Reset();
+    gpu_timer_heap_.Reset();
+    return;
+  }
+  gpu_timer_mapping_ = reinterpret_cast<uint64_t*>(mapping);
+  gpu_timer_enabled_ = true;
+  REXLOG_INFO("GPU timing enabled (timestamp frequency {})", gpu_timer_frequency_);
+}
+
+void D3D12CommandProcessor::GpuTimerWrite() {
+  deferred_command_list_.D3DEndQuery(gpu_timer_heap_.Get(), D3D12_QUERY_TYPE_TIMESTAMP,
+                                     gpu_timer_cursor_++);
+  gpu_timer_intervals_.push_back(gpu_timer_category_);
+}
+
+uint8_t D3D12CommandProcessor::GpuTimerSwitch(uint8_t category) {
+  const uint8_t previous = gpu_timer_category_;
+  if (category == previous) return previous;
+  gpu_timer_category_ = category;
+  if (gpu_timer_enabled_ && submission_open_ &&
+      gpu_timer_cursor_ - gpu_timer_start_ < kGpuTimerMaxPerSubmission - 1) {
+    GpuTimerWrite();
+  }
+  return previous;
+}
+
+void D3D12CommandProcessor::GpuTimerBeginSubmission() {
+  if (!gpu_timer_enabled_) return;
+  if (gpu_timer_cursor_ + kGpuTimerMaxPerSubmission > kGpuTimerQueries) gpu_timer_cursor_ = 0;
+  gpu_timer_start_ = gpu_timer_cursor_;
+  gpu_timer_intervals_.clear();
+  GpuTimerWrite();
+}
+
+void D3D12CommandProcessor::GpuTimerEndSubmission() {
