+  const uint32_t extent_end = extent_start + extent_length;
+  DirectResolveSnapshot* slot = nullptr;
+  for (auto& e : direct_resolves_) {
+    if (e.base == base && e.width == width && e.height == height && e.dxgi_format == dxgi_format) {
+      slot = &e;
+    } else if (e.valid && extent_start < e.extent_end && e.extent_start < extent_end) {
+      e.valid = false;
+      ++direct_resolve_stat_invalidated_;
