+  // Exchanges the recorded contents with another list (O(1)), for handing a
+  // finished list to the replay thread.
+  void SwapContents(DeferredCommandList& other) {
+    command_stream_.swap(other.command_stream_);
+    upload_batches_.swap(other.upload_batches_);
+    std::swap(upload_batch_count_, other.upload_batch_count_);
+  }
+  size_t GetCommandStreamSize() const { return command_stream_.size(); }
+
+  // Shared memory uploads gathered in one place in the list: one transition to
+  // COPY_DEST and back around all of them instead of around each one.
+  uint32_t BeginUploadBatch(ID3D12Resource* dst, D3D12_RESOURCE_STATES state_before) {
+    uint32_t index = uint32_t(upload_batch_count_++);
+    if (index >= upload_batches_.size()) {
+      upload_batches_.emplace_back();
+    }
+    UploadBatch& batch = upload_batches_[index];
+    batch.dst = dst;
+    batch.state_before = state_before;
+    batch.copies.clear();
+    *reinterpret_cast<uint32_t*>(WriteCommand(Command::kUploadBatch, sizeof(uint32_t))) = index;
+    return index;
+  }
+  void AddUploadCopy(uint32_t batch_index, ID3D12Resource* src, UINT64 src_offset,
+                     UINT64 dst_offset, UINT64 num_bytes) {
+    std::vector<UploadCopy>& copies = upload_batches_[batch_index].copies;
+    if (!copies.empty()) {
+      UploadCopy& last = copies.back();
+      if (last.src == src && last.src_offset + last.num_bytes == src_offset &&
+          last.dst_offset + last.num_bytes == dst_offset) {
+        last.num_bytes += num_bytes;
+        return;
+      }
+    }
+    copies.push_back({src, src_offset, dst_offset, num_bytes});
+  }
