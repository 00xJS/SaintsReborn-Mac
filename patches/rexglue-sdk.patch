+        ck.pitch == pitch_div_32 && ck.endianness == endian &&
+        GetDXGIResourceFormat(ck) == dxgi_format) {
+      command_processor_.PushTransitionBarrier(consumer.resource(),
+                                               consumer.SetResourceState(wanted_state), wanted_state);
+      slot->extent_start = extent_start;
+      slot->extent_end = extent_end;
+      slot->valid = true;
+      slot->written_to_consumer = true;
+      slot->last_used_frame = direct_resolve_frame_;
+      ++direct_resolve_stat_direct_writes_;
+      ++direct_resolve_dest_stats_[base].direct_writes;
+      direct_resolve_last_wrote_consumer_ = true;
+      return consumer.resource();
