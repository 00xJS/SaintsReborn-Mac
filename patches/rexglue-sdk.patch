+                   scaled_height);
+      *slot = DirectResolveSnapshot();
+      return nullptr;
+    }
+    slot->state = D3D12_RESOURCE_STATE_COPY_DEST;
+  }
+  slot->base = base;
+  slot->extent_start = extent_start;
+  slot->extent_end = extent_end;
+  slot->width = width;
+  slot->height = height;
+  slot->pitch_div_32 = pitch_div_32;
+  slot->format = format;
+  slot->endian = endian;
+  slot->dxgi_format = dxgi_format;
+  slot->valid = true;
+  slot->last_used_frame = direct_resolve_frame_;
+  if (slot->state != wanted_state) {
+    command_processor_.PushTransitionBarrier(slot->resource.Get(), slot->state, wanted_state);
+    slot->state = wanted_state;
+  }
+  ++direct_resolve_stat_snapshots_;
+  return slot->resource.Get();
+}
+
+bool D3D12TextureCache::TryLoadFromDirectResolve(Texture& texture, bool load_base, bool load_mips) {
+  const TextureKey key = texture.key();
+  if (!key.scaled_resolve) return false;
+  const bool handled = TryLoadFromDirectResolveInner(texture, load_base, load_mips);
+  // (With direct resolve switched off every load goes the old way; that says
+  // nothing about who reads the memory, and skipping is off then anyway.)
+  if (!handled && IsDirectResolveEnabled()) {
+    // Loading the old way: if memory writes were skipped for this range, the
+    // memory is stale - never skip for that destination again.
+    const uint32_t start = uint32_t(key.base_page) << 12;
+    const uint32_t end = start + texture.GetGuestBaseSize();
+    const std::string why = fmt::format("{} ({}x{} fmt {} base {:08X}{})", direct_resolve_last_miss_reason_,
+                                        key.GetWidth(), key.GetHeight(), uint32_t(key.format), start,
+                                        key.mip_max_level ? " mips" : "");
+    std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+    for (auto& e : direct_resolves_) {
+      if (start < e.extent_end && e.extent_start < end) {
+        auto& d = direct_resolve_dest_stats_[e.base];
+        ++d.old_way_loads;
+        d.old_way_reason = why;
+        if (!e.never_skip) d.never_skip_reason = why;
+        // Only a read of memory whose last write was skipped matters: the
+        // memory then really is stale (one wrong frame), and that
+        // destination is never skipped again. Other readers of the same
+        // memory (e.g. a depth view written by a later depth resolve) are
+        // fine while a normal write came last.
+        if (e.memory_stale) {
+          ++direct_resolve_stat_stale_reads_;
+          REXLOG_WARN("Direct resolve: memory at {:08X} was read the old way after its write was "
+                      "skipped ({}) - no more skipping there", e.base, why);
+          e.never_skip = true;
+          e.consumer_streak = 0;
+        }
+      }
+    }
+  }
+  return handled;
+}
+
+bool D3D12TextureCache::TryLoadFromDirectResolveInner(Texture& texture, bool load_base,
+                                                      bool load_mips) {
+  const TextureKey key = texture.key();
+  auto miss = [&](const char* reason) {
+    direct_resolve_last_miss_reason_ = reason;
+    std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+    ++direct_resolve_stat_load_misses_[reason];
+    ++direct_resolve_stat_scaled_loads_normal_;
+    return false;
+  };
+  if (!IsDirectResolveEnabled()) return miss("off");
+  if (!load_base || load_mips || key.mip_max_level != 0) return miss("mips");
+  if (key.dimension != xenos::DataDimension::k2DOrStacked || key.depth_or_array_size_minus_1) {
+    return miss("not 2D");
+  }
+  if (!key.tiled) return miss("linear");
+  if (key.signed_separate) return miss("signed");
+  const uint32_t base = uint32_t(key.base_page) << 12;
+  ID3D12Resource* source = nullptr;
+  {
+    std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+    DirectResolveSnapshot* found = nullptr;
+    for (auto& e : direct_resolves_) {
+      if (e.valid && e.base == base) {
+        found = &e;
+        break;
+      }
+    }
+    if (!found) {
+      direct_resolve_last_miss_reason_ = "no valid snapshot";
+      ++direct_resolve_stat_load_misses_["no snapshot"];
+      ++direct_resolve_stat_scaled_loads_normal_;
+      return false;
+    }
+    const char* reason = nullptr;
+    if (found->format != key.format) reason = "format differs";
+    else if (found->width != key.GetWidth() || found->height != key.GetHeight()) reason = "size differs";
+    else if (found->pitch_div_32 != key.pitch) reason = "pitch differs";
+    else if (found->endian != key.endianness) reason = "endian differs";
+    else if (found->dxgi_format != GetDXGIResourceFormat(key)) reason = "host format differs";
+    if (reason) {
+      direct_resolve_last_miss_reason_ = reason;
+      ++direct_resolve_stat_load_misses_[reason];
+      ++direct_resolve_stat_scaled_loads_normal_;
+      return false;
+    }
+    if (found->written_to_consumer) {
+      if (found->consumer == &texture) {
+        // The resolve already wrote this texture's resource.
+        found->last_used_frame = direct_resolve_frame_;
+        ++direct_resolve_stat_noop_loads_;
+        ++found->consumer_streak;
+        static_cast<D3D12Texture&>(texture).MarkAsUsed();
+        return true;
+      }
+      // Written into another texture of the same memory: no snapshot copy.
+      direct_resolve_last_miss_reason_ = "other consumer";
+      ++direct_resolve_stat_load_misses_["other consumer"];
+      ++direct_resolve_stat_scaled_loads_normal_;
+      return false;
+    }
+    found->consumer = &texture;
+    source = found->resource.Get();
+    if (found->state != D3D12_RESOURCE_STATE_COPY_SOURCE) {
+      command_processor_.PushTransitionBarrier(source, found->state,
+                                               D3D12_RESOURCE_STATE_COPY_SOURCE);
+      found->state = D3D12_RESOURCE_STATE_COPY_SOURCE;
+    }
+    found->last_used_frame = direct_resolve_frame_;
+    ++direct_resolve_stat_loads_;
+  }
+  D3D12Texture& d3d12_texture = static_cast<D3D12Texture&>(texture);
+  ID3D12Resource* texture_resource = d3d12_texture.resource();
+  command_processor_.PushTransitionBarrier(
+      texture_resource, d3d12_texture.SetResourceState(D3D12_RESOURCE_STATE_COPY_DEST),
+      D3D12_RESOURCE_STATE_COPY_DEST);
+  command_processor_.SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION location_source, location_dest;
+  location_source.pResource = source;
+  location_source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  location_source.SubresourceIndex = 0;
+  location_dest.pResource = texture_resource;
+  location_dest.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  location_dest.SubresourceIndex = 0;
+  command_processor_.GetDeferredCommandList().D3DCopyTextureRegion(&location_dest, 0, 0, 0,
+                                                                   &location_source, nullptr);
+  d3d12_texture.MarkAsUsed();
+  return true;
+}
+
+void D3D12TextureCache::LogDirectResolveStats() {
+  const uint64_t now = GetTickCount64();
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  if (!direct_resolve_stat_tick_) direct_resolve_stat_tick_ = now;
+  if (now - direct_resolve_stat_tick_ < 10000) return;
+  const double seconds = double(now - direct_resolve_stat_tick_) / 1000.0;
+  direct_resolve_stat_tick_ = now;
+  std::string skips, misses;
+  for (const auto& [k, v] : direct_resolve_stat_skips_) skips += fmt::format(" [{}: {:.1f}/s]", k, v / seconds);
+  for (const auto& [k, v] : direct_resolve_stat_load_misses_) misses += fmt::format(" [{}: {:.1f}/s]", k, v / seconds);
+  size_t valid = 0;
+  for (const auto& e : direct_resolves_) valid += e.valid;
+  REXLOG_INFO(
+      "DIRECT RESOLVE per second: direct writes into textures {:.1f}, loads skipped {:.1f}, "
+      "snapshots {:.1f}, loads from snapshots {:.1f}, scaled loads the "
+      "old way {:.1f}, invalidated {:.1f} (by CPU {:.1f}), memory writes skipped {:.1f}, stale "
+      "reads {:.1f} | snapshots kept {} ({} valid) | resolves "
+      "not snapshotted:{} | loads not from snapshots:{}",
+      direct_resolve_stat_direct_writes_ / seconds, direct_resolve_stat_noop_loads_ / seconds,
+      direct_resolve_stat_snapshots_ / seconds, direct_resolve_stat_loads_ / seconds,
+      direct_resolve_stat_scaled_loads_normal_ / seconds, direct_resolve_stat_invalidated_ / seconds,
+      direct_resolve_stat_cpu_invalidated_ / seconds, direct_resolve_stat_memory_skips_ / seconds,
+      direct_resolve_stat_stale_reads_ / seconds, direct_resolves_.size(), valid, skips, misses);
+  direct_resolve_stat_memory_skips_ = direct_resolve_stat_stale_reads_ = 0;
+  {
+    std::vector<std::pair<uint32_t, DirectResolveDestStats>> v(direct_resolve_dest_stats_.begin(),
+                                                               direct_resolve_dest_stats_.end());
+    std::sort(v.begin(), v.end(), [](const auto& a, const auto& b) { return a.second.resolves > b.second.resolves; });
+    for (size_t i = 0; i < v.size() && i < 16; ++i) {
+      const auto& d = v[i].second;
+      const char* why_no_skip = "?";
+      for (const auto& e : direct_resolves_) {
+        if (e.base == v[i].first) {
+          why_no_skip = !e.consumer ? "no consumer" : e.never_skip ? "read old way" :
+                        e.consumer_streak < 3 ? "streak<3" : "ok";
+          break;
+        }
+      }
+      REXLOG_INFO(
+          "  DR dest {:08X} {}x{}: resolves {:.1f}/s, direct {:.1f}, memory skipped {:.1f}, not direct "
+          "{:.1f} [{}], old-way loads {:.1f} [{}], skip state: {} [{}]",
+          v[i].first, d.width, d.height, d.resolves / seconds, d.direct_writes / seconds,
+          d.memory_skipped / seconds, d.not_direct / seconds, d.not_direct_reason, d.old_way_loads / seconds,
+          d.old_way_reason, why_no_skip, d.never_skip_reason);
+    }
+    direct_resolve_dest_stats_.clear();
+  }
+  direct_resolve_stat_direct_writes_ = direct_resolve_stat_noop_loads_ = 0;
+  direct_resolve_stat_snapshots_ = direct_resolve_stat_loads_ = direct_resolve_stat_scaled_loads_normal_ =
+      direct_resolve_stat_invalidated_ = direct_resolve_stat_cpu_invalidated_ = 0;
+  direct_resolve_stat_skips_.clear();
+  direct_resolve_stat_load_misses_.clear();
+}
