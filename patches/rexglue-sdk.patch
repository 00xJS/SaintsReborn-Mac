+// ---------------------------------------------------------------------------
+// DIRECT RESOLVE. See the header.
+
+bool D3D12TextureCache::IsDirectResolveEnabled() {
+  if (!IsDrawResolutionScaled()) return false;
+  static std::atomic<int> enabled{-1};
+  static std::atomic<uint64_t> next_check{0};
+  const uint64_t now = GetTickCount64();
+  if (enabled.load(std::memory_order_relaxed) < 0 || now >= next_check.load(std::memory_order_relaxed)) {
+    next_check.store(now + 500, std::memory_order_relaxed);
+    const bool on = GetFileAttributesW(L"direct_resolve_off") == INVALID_FILE_ATTRIBUTES;
+    const int old = enabled.exchange(on ? 1 : 0);
+    if (old != (on ? 1 : 0)) {
+      REXLOG_INFO("Direct resolve {}", on ? "ON" : "OFF (direct_resolve_off file)");
+      if (!on) {
+        std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+        for (auto& e : direct_resolves_) e.valid = false;
+      }
+    }
+  }
+  return enabled.load(std::memory_order_relaxed) == 1;
+}
+
+void D3D12TextureCache::CountDirectResolveSkip(uint32_t base, const char* reason) {
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  ++direct_resolve_stat_skips_[reason];
+  auto& d = direct_resolve_dest_stats_[base];
+  ++d.not_direct;
+  d.not_direct_reason = reason;
+}
+
+void D3D12TextureCache::CountResolveForStats(uint32_t base, uint32_t width, uint32_t height,
+                                             bool memory_skipped) {
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  auto& d = direct_resolve_dest_stats_[base];
+  d.width = width;
+  d.height = height;
+  ++d.resolves;
+  if (memory_skipped) ++d.memory_skipped;
+}
+
+const char* D3D12TextureCache::WhyNotSkipResolveMemory(uint32_t base) {
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  for (const auto& e : direct_resolves_) {
+    if (e.base == base) {
+      if (!e.consumer) return "no consumer texture";
+      if (e.never_skip) return "read the old way";
+      if (e.consumer_streak < 3) return "streak < 3";
+      return "ok";
+    }
+  }
+  return "no entry";
+}
+
+void D3D12TextureCache::InvalidateDirectResolves(uint32_t start, uint32_t length,
+                                                 bool memory_written) {
+  const uint32_t end = start + length;
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  for (auto& e : direct_resolves_) {
+    if (memory_written && start < e.extent_end && e.extent_start < end) e.memory_stale = false;
+    if (e.valid && start < e.extent_end && e.extent_start < end) {
+      e.valid = false;
+      ++direct_resolve_stat_invalidated_;
+    }
+  }
+}
+
+
+bool D3D12TextureCache::IsDirectResolveMemorySkipEnabled() {
+  static std::atomic<int> enabled{0};
+  static std::atomic<uint64_t> next_check{0};
+  const uint64_t now = GetTickCount64();
+  if (now >= next_check.load(std::memory_order_relaxed)) {
+    next_check.store(now + 500, std::memory_order_relaxed);
+    const bool on =
+        GetFileAttributesW(L"direct_resolve_skip_memory.off") == INVALID_FILE_ATTRIBUTES;
+    if (enabled.exchange(on ? 1 : 0) != (on ? 1 : 0)) {
+      REXLOG_INFO("Direct resolve memory skip {}", on ? "on" : "OFF (direct_resolve_skip_memory.off)");
+    }
+  }
+  return enabled.load(std::memory_order_relaxed) == 1 && IsDirectResolveEnabled();
+}
+
+bool D3D12TextureCache::CanSkipResolveMemory(uint32_t base) {
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  for (const auto& e : direct_resolves_) {
+    if (e.base == base) {
+      return e.consumer && !e.never_skip && e.consumer_streak >= 3;
+    }
+  }
+  return false;
+}
+
+void D3D12TextureCache::SetDirectResolveMemorySkipped(uint32_t base, bool skipped) {
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  for (auto& e : direct_resolves_) {
+    if (e.base == base) {
+      e.memory_stale = skipped;
+      if (skipped) ++direct_resolve_stat_memory_skips_;
+    }
+  }
