+bool D3D12RenderTargetCache::EnsureDirectResolveCopyPipeline() {
+  if (direct_resolve_copy_pipeline_) return true;
+  if (direct_resolve_copy_init_tried_) return false;
+  direct_resolve_copy_init_tried_ = true;
+  typedef HRESULT(WINAPI * D3DCompileFunction)(
+      LPCVOID src_data, SIZE_T src_data_size, LPCSTR source_name, const D3D_SHADER_MACRO* defines,
+      ID3DInclude* include, LPCSTR entry_point, LPCSTR target, UINT flags1, UINT flags2,
+      ID3DBlob** code, ID3DBlob** error_msgs);
+  HMODULE compiler = LoadLibraryW(L"d3dcompiler_47.dll");
+  auto compile = compiler ? reinterpret_cast<D3DCompileFunction>(GetProcAddress(compiler, "D3DCompile"))
+                          : nullptr;
+  if (!compile) {
+    REXLOG_ERROR("Direct resolve: D3DCompile not available");
+    return false;
+  }
+  ID3DBlob* code = nullptr;
+  ID3DBlob* errors = nullptr;
+  HRESULT hr = compile(kDirectResolveCopyCS, sizeof(kDirectResolveCopyCS) - 1, "direct_resolve_copy",
+                       nullptr, nullptr, "main", "cs_5_1", 1u << 15, 0, &code, &errors);
+  if (errors) {
+    REXLOG_ERROR("Direct resolve: shader compiler output: {}",
+                 std::string(static_cast<const char*>(errors->GetBufferPointer()), errors->GetBufferSize()));
+    errors->Release();
+  }
+  if (FAILED(hr) || !code) {
+    REXLOG_ERROR("Direct resolve: failed to compile the copy shader (0x{:08X})", uint32_t(hr));
+    return false;
+  }
+  D3D12_DESCRIPTOR_RANGE ranges[2] = {};
+  ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+  ranges[0].NumDescriptors = 1;
+  ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+  ranges[1].NumDescriptors = 1;
+  D3D12_ROOT_PARAMETER parameters[3] = {};
+  parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  parameters[0].Constants.Num32BitValues = 6;
+  parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  for (int i = 0; i < 2; ++i) {
+    parameters[1 + i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    parameters[1 + i].DescriptorTable.NumDescriptorRanges = 1;
+    parameters[1 + i].DescriptorTable.pDescriptorRanges = &ranges[i];
+    parameters[1 + i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  }
+  D3D12_ROOT_SIGNATURE_DESC desc = {};
+  desc.NumParameters = 3;
+  desc.pParameters = parameters;
+  direct_resolve_copy_root_signature_.Attach(
+      ui::d3d12::util::CreateRootSignature(command_processor_.GetD3D12Provider(), desc));
+  if (!direct_resolve_copy_root_signature_) {
+    code->Release();
+    REXLOG_ERROR("Direct resolve: failed to create the copy root signature");
+    return false;
+  }
+  D3D12_COMPUTE_PIPELINE_STATE_DESC pso = {};
+  pso.pRootSignature = direct_resolve_copy_root_signature_.Get();
+  pso.CS.pShaderBytecode = code->GetBufferPointer();
+  pso.CS.BytecodeLength = code->GetBufferSize();
+  hr = command_processor_.GetD3D12Provider().GetDevice()->CreateComputePipelineState(
+      &pso, IID_PPV_ARGS(&direct_resolve_copy_pipeline_));
+  code->Release();
+  if (FAILED(hr)) {
+    REXLOG_ERROR("Direct resolve: failed to create the copy pipeline (0x{:08X})", uint32_t(hr));
+    return false;
+  }
+  REXLOG_INFO("Direct resolve: copy shader ready");
+  return true;
+}
