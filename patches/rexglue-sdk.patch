+void D3D12SharedMemory::CloseUploadSegment() {
+  upload_batch_open_ = false;
+  for (uint32_t block : segment_touched_blocks_) {
+    segment_used_pages_[block] = 0;
+    segment_uploaded_pages_[block] = 0;
+    segment_block_touched_[block] = 0;
+  }
+  segment_touched_blocks_.clear();
+}
+
+void D3D12SharedMemory::MarkSegmentPages(std::vector<uint64_t>& bits, uint32_t page_first,
+                                         uint32_t page_count) {
+  if (!page_count) {
+    return;
+  }
+  uint32_t page_last = page_first + page_count - 1;
+  for (uint32_t block = page_first >> 6; block <= (page_last >> 6) && block < bits.size();
+       ++block) {
+    uint64_t mask = UINT64_MAX;
+    if (block == (page_first >> 6)) {
+      mask &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    }
+    if (block == (page_last >> 6) && (page_last & 63) != 63) {
+      mask &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    bits[block] |= mask;
+    if (!segment_block_touched_[block]) {
+      segment_block_touched_[block] = 1;
+      segment_touched_blocks_.push_back(block);
+    }
+  }
+}
+
+bool D3D12SharedMemory::SegmentPagesSet(const std::vector<uint64_t>& bits, uint32_t page_first,
+                                        uint32_t page_count) const {
+  if (!page_count) {
+    return false;
+  }
+  uint32_t page_last = page_first + page_count - 1;
+  for (uint32_t block = page_first >> 6; block <= (page_last >> 6) && block < bits.size();
+       ++block) {
+    uint64_t mask = UINT64_MAX;
+    if (block == (page_first >> 6)) {
+      mask &= ~((uint64_t(1) << (page_first & 63)) - 1);
+    }
+    if (block == (page_last >> 6) && (page_last & 63) != 63) {
+      mask &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    if (bits[block] & mask) {
+      return true;
+    }
+  }
+  return false;
+}
+
+void D3D12SharedMemory::OnRangesUsed(const std::pair<uint32_t, uint32_t>* ranges, size_t count) {
+  if (!upload_batching_ || !upload_batch_open_) {
+    // Nothing moved before this point in the current segment yet: reads before
+    // the segment's first upload are before its batch anyway.
+    return;
+  }
+  for (size_t i = 0; i < count; ++i) {
+    if (!ranges[i].second) {
+      continue;
+    }
+    uint32_t page_first = ranges[i].first >> page_size_log2();
+    uint32_t page_last = (ranges[i].first + ranges[i].second - 1) >> page_size_log2();
+    MarkSegmentPages(segment_used_pages_, page_first, page_last - page_first + 1);
+  }
+}
