+const uint32_t* CommandProcessor::SelectGuestDataSource(uint32_t address, uint32_t size_dwords) {
+  // Guest data read by the GPU may have been written only through the virtual
+  // mapping, which is separate host memory from the physical view here. Prefer
+  // the physical view unless it is empty and the virtual one is not.
+  const uint32_t* phys = memory_->TranslatePhysical<const uint32_t*>(address);
+  if (!size_dwords) {
+    return phys;
+  }
+  const uint32_t probe = std::min(size_dwords, uint32_t(64));
+  for (uint32_t i = 0; i < probe; ++i) {
+    if (phys[i] != 0) {
+      return phys;
+    }
+  }
+  const uint32_t* virt = memory_->TranslateVirtual<const uint32_t*>(address);
+  for (uint32_t i = 0; i < probe; ++i) {
+    if (virt[i] != 0) {
+      return virt;
+    }
+  }
+  return phys;
+}
