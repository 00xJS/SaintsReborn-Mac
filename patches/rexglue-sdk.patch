+bool D3D12RenderTargetCache::SnapshotDirectResolve(const draw_util::ResolveInfo& resolve_info,
+                                                   D3D12TextureCache& texture_cache) {
+  if (!texture_cache.IsDirectResolveEnabled()) return false;
+  auto skip = [&](const char* reason) {
+    texture_cache.CountDirectResolveSkip(resolve_info.copy_dest_base, reason);
+    return false;
+  };
+  if (resolve_info.IsCopyingDepth()) return skip("depth");
+  const draw_util::ResolveEdramInfo edram = resolve_info.color_edram_info;
+  if (edram.msaa_samples != xenos::MsaaSamples::k1X) return skip("msaa");
+  if (xenos::ColorRenderTargetFormat(edram.format) != xenos::ColorRenderTargetFormat::k_8_8_8_8) {
+    return skip("rt format not 8888");
+  }
+  const reg::RB_COPY_DEST_INFO dest_info = resolve_info.copy_dest_info;
+  if (dest_info.copy_dest_format != xenos::ColorFormat::k_8_8_8_8) return skip("dest format not 8888");
+  if (uint32_t(dest_info.copy_dest_number) != 0) return skip("dest number format");
+  if (dest_info.copy_dest_array || dest_info.copy_dest_slice) return skip("3d dest");
+  if (uint32_t(dest_info.copy_dest_endian) > 3) return skip("128-bit endian");
+  const draw_util::ResolveCopyDestCoordinateInfo dest_coords = resolve_info.copy_dest_coordinate_info;
+  if (dest_coords.offset_x_div_8 || dest_coords.offset_y_div_8) return skip("dest offset");
+  if (resolve_info.copy_dest_base & 0xFFF) return skip("dest not page aligned");
+
+  uint32_t dump_base, dump_row_length_used, dump_rows, dump_pitch;
+  resolve_info.GetCopyEdramTileSpan(dump_base, dump_row_length_used, dump_rows, dump_pitch);
+  std::vector<ResolveCopyDumpRectangle> rectangles;
+  GetResolveCopyRectanglesToDump(dump_base, dump_row_length_used, dump_rows, dump_pitch, rectangles);
+  if (rectangles.size() != 1) return skip(rectangles.empty() ? "no render target" : "several render targets");
+  auto& rt = *static_cast<D3D12RenderTarget*>(rectangles[0].render_target);
+  const RenderTargetKey rt_key = rt.key();
+  if (rt_key.is_depth || rt_key.msaa_samples != xenos::MsaaSamples::k1X ||
+      xenos::ColorRenderTargetFormat(rt_key.resource_format) != xenos::ColorRenderTargetFormat::k_8_8_8_8) {
+    return skip("render target not plain 8888");
+  }
+  if (rt_key.pitch_tiles_at_32bpp != edram.pitch_tiles) return skip("pitch differs");
+  const uint32_t pitch = edram.pitch_tiles;
+  const uint32_t delta = (edram.base_tiles - rt_key.base_tiles) & (xenos::kEdramTileCount - 1);
+  const uint32_t scale_x = draw_resolution_scale_x(), scale_y = draw_resolution_scale_y();
+  const uint32_t x0 = ((delta % pitch) * xenos::kEdramTileWidthSamples +
+                       resolve_info.coordinate_info.edram_offset_x_div_8 * 8) * scale_x;
+  const uint32_t y0 = ((delta / pitch) * xenos::kEdramTileHeightSamples +
+                       resolve_info.coordinate_info.edram_offset_y_div_8 * 8) * scale_y;
+  const uint32_t width = resolve_info.coordinate_info.width_div_8 * 8;
+  const uint32_t height = resolve_info.height_div_8 * 8;
+  const D3D12_RESOURCE_DESC rt_desc = rt.resource()->GetDesc();
+  if (x0 + width * scale_x > rt_desc.Width || y0 + height * scale_y > rt_desc.Height) {
+    return skip("outside the render target");
+  }
+  const bool needs_shader = dest_info.copy_dest_swap || dest_info.copy_dest_exp_bias;
+  if (needs_shader && !EnsureDirectResolveCopyPipeline()) return skip("no copy shader");
+  ID3D12Resource* snapshot = texture_cache.BeginDirectResolve(
+      resolve_info.copy_dest_base, resolve_info.copy_dest_extent_start,
+      resolve_info.copy_dest_extent_length, width, height, dest_coords.pitch_aligned_div_32,
+      xenos::TextureFormat::k_8_8_8_8, xenos::Endian(uint32_t(dest_info.copy_dest_endian)),
+      needs_shader ? D3D12_RESOURCE_STATE_UNORDERED_ACCESS : D3D12_RESOURCE_STATE_COPY_DEST);
+  if (!snapshot) return skip("no snapshot texture");
+  if (needs_shader) {
+    // Swap red/blue and/or apply 2^exp_bias like the resolve copy shader does.
+    ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[2];
+    if (!command_processor_.RequestOneUseSingleViewDescriptors(2, descriptors)) {
+      texture_cache.InvalidateDirectResolves(resolve_info.copy_dest_extent_start,
+                                             resolve_info.copy_dest_extent_length);
+      return skip("no descriptors");
+    }
+    ID3D12Device* device = command_processor_.GetD3D12Provider().GetDevice();
+    device->CopyDescriptorsSimple(1, descriptors[0].first, rt.descriptor_srv().GetHandle(),
+                                  D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_UNORDERED_ACCESS_VIEW_DESC uav_desc = {};
+    uav_desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    uav_desc.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    device->CreateUnorderedAccessView(snapshot, nullptr, &uav_desc, descriptors[1].first);
+    command_processor_.PushTransitionBarrier(
+        rt.resource(), rt.SetResourceState(D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE),
+        D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    struct {
+      uint32_t origin_x, origin_y, size_x, size_y, swap;
+      float scale;
+    } constants = {x0, y0, width * scale_x, height * scale_y, uint32_t(dest_info.copy_dest_swap),
+                   std::ldexp(1.0f, int(dest_info.copy_dest_exp_bias))};
+    DeferredCommandList& list = command_processor_.GetDeferredCommandList();
+    command_processor_.SetExternalPipeline(direct_resolve_copy_pipeline_.Get());
+    list.D3DSetComputeRootSignature(direct_resolve_copy_root_signature_.Get());
+    list.D3DSetComputeRoot32BitConstants(0, 6, &constants, 0);
+    list.D3DSetComputeRootDescriptorTable(1, descriptors[0].second);
+    list.D3DSetComputeRootDescriptorTable(2, descriptors[1].second);
+    command_processor_.SubmitBarriers();
+    list.D3DDispatch((constants.size_x + 7) / 8, (constants.size_y + 7) / 8, 1);
+    return true;
+  }
+  command_processor_.PushTransitionBarrier(
+      rt.resource(), rt.SetResourceState(D3D12_RESOURCE_STATE_COPY_SOURCE),
+      D3D12_RESOURCE_STATE_COPY_SOURCE);
+  command_processor_.SubmitBarriers();
+  D3D12_TEXTURE_COPY_LOCATION location_source, location_dest;
+  location_source.pResource = rt.resource();
+  location_source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  location_source.SubresourceIndex = 0;
+  location_dest.pResource = snapshot;
+  location_dest.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+  location_dest.SubresourceIndex = 0;
+  D3D12_BOX box;
+  box.left = x0;
+  box.top = y0;
+  box.front = 0;
+  box.right = x0 + width * scale_x;
+  box.bottom = y0 + height * scale_y;
+  box.back = 1;
+  command_processor_.GetDeferredCommandList().D3DCopyTextureRegion(&location_dest, 0, 0, 0,
+                                                                   &location_source, &box);
+  return true;
+}
