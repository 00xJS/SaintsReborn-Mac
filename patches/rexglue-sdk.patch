+                                                      uint32_t height, uint32_t pitch_div_32,
+                                                      xenos::TextureFormat format,
+                                                      xenos::Endian endian,
+                                                      D3D12_RESOURCE_STATES wanted_state) {
+  const DXGI_FORMAT dxgi_format = GetDXGIResourceFormat(format, width, height);
+  if (dxgi_format == DXGI_FORMAT_UNKNOWN) return nullptr;
+  const uint32_t scaled_width = width * draw_resolution_scale_x();
+  const uint32_t scaled_height = height * draw_resolution_scale_y();
+  const uint64_t completed = command_processor_.GetCompletedSubmission();
+  std::lock_guard<std::mutex> lock(direct_resolve_mutex_);
+  // Free replaced snapshots the GPU is done with.
+  direct_resolve_graveyard_.erase(
+      std::remove_if(direct_resolve_graveyard_.begin(), direct_resolve_graveyard_.end(),
