+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <list>
+#include <mutex>
+#include <span>
+#include <unordered_map>
+#include <vector>
+
+namespace rex::filesystem {
+
+// Exact-range cache for immutable game files. Misses retain the original host
+// read, including its short-read/error behavior; only complete reads are stored.
+// IDs belong to open handles, so closing/reopening cannot reuse stale contents.
+class ReadCache {
+ public:
+  struct Stats { uint64_t hits = 0, misses = 0, saved_bytes = 0; size_t bytes = 0, entries = 0; };
+  void SetBudget(size_t bytes) {
+    std::lock_guard lock(mutex_);
+    budget_ = bytes;
+    Trim(0);
+  }
+  bool Read(uint64_t file, size_t offset, std::span<uint8_t> output) {
+    std::lock_guard lock(mutex_);
+    auto it = entries_.find(Key{file, offset, output.size()});
+    if (it == entries_.end()) { ++stats_.misses; return false; }
+    auto node = it->second;
+    std::memcpy(output.data(), node->data.data(), output.size());
+    lru_.splice(lru_.begin(), lru_, node);
+    ++stats_.hits;
+    stats_.saved_bytes += output.size();
+    return true;
+  }
+  void Store(uint64_t file, size_t offset, std::span<const uint8_t> input) {
+    std::lock_guard lock(mutex_);
+    if (input.empty() || input.size() > budget_ || input.size() > 1024 * 1024) return;
+    Key key{file, offset, input.size()};
+    if (entries_.contains(key)) return;
+    // Allocate before changing accounting. Cache failure must not fail the read.
+    try {
+      std::vector<uint8_t> copy(input.begin(), input.end());
+      Trim(input.size());
+      lru_.push_front(Node{key, std::move(copy)});
+      try {
+        entries_.emplace(key, lru_.begin());
+      } catch (...) {
+        lru_.pop_front();
+        throw;
+      }
+      stats_.bytes += input.size();
+    } catch (const std::bad_alloc&) {
+      // The caller already has valid data; caching is optional.
+    }
+  }
+  void EraseFile(uint64_t file) {
+    std::lock_guard lock(mutex_);
+    for (auto it = lru_.begin(); it != lru_.end();) {
+      if (it->key.file != file) { ++it; continue; }
+      stats_.bytes -= it->data.size();
+      entries_.erase(it->key);
+      it = lru_.erase(it);
+    }
+  }
+  Stats GetStats() {
+    std::lock_guard lock(mutex_);
+    auto result = stats_;
+    result.entries = entries_.size();
+    return result;
+  }
+ private:
+  struct Key {
+    uint64_t file;
+    size_t offset, size;
+    bool operator==(const Key&) const = default;
+  };
+  struct Hash {
+    size_t operator()(const Key& key) const {
+      size_t h = std::hash<uint64_t>{}(key.file);
+      h ^= std::hash<size_t>{}(key.offset) + 0x9e3779b9 + (h << 6) + (h >> 2);
+      return h ^ (std::hash<size_t>{}(key.size) + 0x9e3779b9 + (h << 6) + (h >> 2));
+    }
+  };
+  struct Node { Key key; std::vector<uint8_t> data; };
+  void Trim(size_t incoming) {
+    while (!lru_.empty() && (stats_.bytes > budget_ - incoming ||
+           (incoming != 0 && entries_.size() >= 32768))) {
+      auto& node = lru_.back();
+      stats_.bytes -= node.data.size();
+      entries_.erase(node.key);
+      lru_.pop_back();
+    }
+  }
+  std::mutex mutex_;
+  size_t budget_ = 0;
+  Stats stats_;
+  std::list<Node> lru_;
+  std::unordered_map<Key, std::list<Node>::iterator, Hash> entries_;
+};
+}  // namespace rex::filesystem
