+// DIRECT RESOLVE snapshot: for a resolve
+// of a whole plain 8888 colour render target into an 8888 texture, also copy
+// the host render target region into a host texture owned by the texture
+// cache, so loading that texture later is one GPU copy instead of an untile
+// from the scaled resolve buffer. The normal resolve still runs (memory stays
+// correct for anything else reading it).
+static const char kDirectResolveCopyCS[] = R"(
+Texture2D<float4> source : register(t0);
+RWTexture2D<unorm float4> dest : register(u0);
+cbuffer constants : register(b0) {
+  uint2 origin;
+  uint2 size;
+  uint swap_red_blue;
+  float scale;
+};
+[numthreads(8, 8, 1)]
+void main(uint3 id : SV_DispatchThreadID) {
+  if (id.x >= size.x || id.y >= size.y) return;
+  float4 color = source.Load(int3(origin + id.xy, 0));
+  if (swap_red_blue) color = color.bgra;
+  dest[id.xy] = saturate(color * scale);
